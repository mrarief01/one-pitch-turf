# Razorpay API Credentials
# Replace with your actual Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Supabase project settings (Project Settings > API)
# Use the publishable/anon key here. Do not expose a service_role key in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Email notifications (sent to customer + owner when a booking is paid & confirmed)
# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
# Must use a domain you've verified in Resend (resend.com/domains), e.g. "OnePitch Turf <bookings@yourdomain.com>"
# Until verified, Resend's sandbox mode only lets you send to your own signup email.
EMAIL_FROM="OnePitch Turf <bookings@yourdomain.com>"
# The turf owner's inbox that should receive new-booking notifications
OWNER_EMAIL=onepitchturf@gmail.com

# WhatsApp notifications (Meta's official WhatsApp Business Cloud API)
# Setup steps: see the comment block at the top of src/lib/whatsapp.ts
WHATSAPP_TOKEN=your_permanent_or_temporary_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_API_VERSION=v21.0
# Names of your two APPROVED message templates in WhatsApp Manager
WHATSAPP_TEMPLATE_CUSTOMER=booking_confirmed
WHATSAPP_TEMPLATE_OWNER=owner_new_booking
WHATSAPP_TEMPLATE_LANG=en_US
# Owner's WhatsApp number, with country code, no "+", e.g. 919876543210
OWNER_WHATSAPP_NUMBER=919876543210
